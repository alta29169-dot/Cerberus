-- ============================================
-- TARGET DETECTION
-- ============================================

local function isEnemy(playerToCheck)
    if not playerToCheck or playerToCheck == player then return false end
    if not player.Team or not playerToCheck.Team then return false end
    if playerToCheck.Team == player.Team then return false end
    
    local character = playerToCheck.Character
    if not character then return false end
    
    local inGame = character:FindFirstChild("InGame")
    if not inGame or not inGame:IsA("StringValue") then return false end
    
    local hasRPG = false
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and child.Name == "RPG" then
            hasRPG = true
            break
        end
    end
    
    return hasRPG
end

local function getValidTargets()
    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) then
            local character = plr.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp then
                table.insert(targets, {
                    player = plr,
                    character = character,
                    hrp = hrp,
                    position = hrp.Position
                })
            end
        end
    end
    return targets
end

local function getClosestTarget()
    local character = player.Character
    if not character then return nil end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local pos = hrp.Position
    local targets = getValidTargets()
    
    if #targets == 0 then return nil end
    
    table.sort(targets, function(a, b)
        local distA = (a.position - pos).Magnitude
        local distB = (b.position - pos).Magnitude
        return distA < distB
    end)
    
    return targets[1]
end

-- ============================================
-- FIRING LOGIC
-- ============================================

local function getNextBodyPart(character)
    local partName = BODY_PARTS[bodyPartIndex]
    bodyPartIndex = bodyPartIndex + 1
    if bodyPartIndex > #BODY_PARTS then
        bodyPartIndex = 1
    end
    return character:FindFirstChild(partName)
end

local function fireRifle(targetPlayer, targetCharacter)
    if not targetPlayer or not targetCharacter then return false end
    
    local bodyPart = getNextBodyPart(targetCharacter)
    if not bodyPart then
        bodyPart = targetCharacter:FindFirstChild("Head")
        if not bodyPart then return false end
    end
    
    local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    local success1 = pcall(function()
        Event:FireServer("shootRifle", "hit", { humanoid })
    end)
    
    if not success1 then return false end
    
    task.wait(0.03)
    
    local success2 = pcall(function()
        Event:FireServer("shootRifle", "", { bodyPart })
    end)
    
    if not success2 then return false end
    
    return true
end

local function teleportToTarget(targetPosition)
    local character = player.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local teleportPos = targetPosition + TELEPORT_OFFSET
    root.CFrame = CFrame.new(teleportPos)
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    
    setupFloat(teleportPos.Y)
end

-- ============================================
-- KILL AURA LOOP
-- ============================================

local function killAuraLoop()
    while isActive do
        if not isEnabled then break end
        
        local target = getClosestTarget()
        
        if target then
            currentTarget = target.player
            equipRifle()
            
            local character = player.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local distance = hrp and (target.position - hrp.Position).Magnitude or math.huge
            
            if distance > KILL_RANGE then
                teleportToTarget(target.position)
            end
            
            fireRifle(target.player, target.character)
            maintainFloat()
        end
        
        task.wait(FIRE_DELAY)
    end
end

local function startKillAura()
    if isActive then return end
    isActive = true
    task.spawn(killAuraLoop)
end

local function stopKillAura()
    isActive = false
    cleanupFloat()
    currentTarget = nil
    isTransitioning = false
end

-- ============================================
-- RESPAWN HANDLING
-- ============================================

local function onRespawn()
    
    isActive = false
    cleanupFloat()
    bodyPartIndex = 1
    
    task.wait(RESPAWN_WAIT)
    
    if isEnabled then
        local needsSetup = true
        local char = player.Character
        if char then
            local inGame = char:FindFirstChild("InGame")
            if inGame and inGame:IsA("StringValue") and inGame.Value ~= "" then
                needsSetup = false
            end
        end
        
        if needsSetup then
            setupHarbour()
            task.wait(0.5)
        end
        
        PatchAllGunsInBackpack()
        equipRifle()
        startKillAura()
    end
end

