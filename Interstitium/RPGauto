-- ============================================
-- INFINITE AMMO PATCHER (unchanged)
-- ============================================

local function safecall(fn, ...)
    local ok, a, b, c = pcall(fn, ...)
    if ok then return a, b, c end
    return nil
end

local function safe_table(fn)
    local ok, t = pcall(fn)
    return (ok and type(t) == "table") and t or {}
end

local function is_lua_closure(func)
    if type(islclosure) ~= "function" then return false end
    local ok, res = pcall(islclosure, func)
    return ok and res
end

local function AvoidCrasher(fenv, inst)
    if type(fenv) ~= "table" then return false end
    for i, v in pairs(fenv) do
        if i == "script" and typeof(v) == "Instance" and v.ClassName == inst.ClassName and v == inst then
            return true
        end
    end
    return false
end

local function LoopThroughTable(tab, inst, source)
    if type(source) ~= "table" then return end
    for _, v in pairs(source) do
        if type(v) == "function" then
            if is_lua_closure(v) then
                local ok, fenv = pcall(getfenv, v)
                if ok and fenv and AvoidCrasher(fenv, inst) then
                    table.insert(tab, v)
                end
            end
        end
    end
end

local function GetFunctionsFromScript(inst)
    local funcs = {}
    LoopThroughTable(funcs, inst, safe_table(getgc))
    LoopThroughTable(funcs, inst, safe_table(function() return debug and debug.getregistry and debug.getregistry() end))
    return funcs
end

local function SafeGetConstants(f)
    local ok, consts = pcall(function() return debug.getconstants(f) end)
    if ok and type(consts) == "table" then return consts end
    return {}
end

local function SafeGetUpvalue(f, idx)
    local ok, val = pcall(function() return debug.getupvalue(f, idx) end)
    if ok then return val end
    return nil
end

local function SafeSetupValue(f, idx, val)
    local ok = pcall(function() debug.setupvalue(f, idx, val) end)
    return ok
end

local function SafeSetConstant(f, idx, val)
    local ok = pcall(function() debug.setconstant(f, idx, val) end)
    return ok
end

local function ChangeAmmoGun(gun)
    if not gun or not gun:FindFirstChild("TriggerScript") then return end
    local scriptInst = gun.TriggerScript
    local funcs = GetFunctionsFromScript(scriptInst)
    if #funcs == 0 then return end

    for _, f in pairs(funcs) do
        local consts = SafeGetConstants(f)

        if table.find(consts, "Reloading...") then
            local patched = false
            for upi = 1, 20 do
                local uv = SafeGetUpvalue(f, upi)
                if type(uv) == "number" then
                    if SafeSetupValue(f, upi, 99999999) then
                        patched = true
                        break
                    end
                end
            end
            if not patched then
                pcall(function()
                    if type(hookfunction) == "function" then
                        hookfunction(f, function() end)
                    end
                end)
            end
        end

        if table.find(consts, "Ray") then
            for ci, c in ipairs(consts) do
                if type(c) == "number" then
                    if SafeSetConstant(f, ci, 999999999) then
                        break
                    end
                end
            end
        end
    end
end

local function PatchAllGunsInBackpack()
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end
    for _, item in pairs(backpack:GetChildren()) do
        pcall(ChangeAmmoGun, item)
    end
end

-- ============================================
-- AUTO EQUIP RIFLE
-- ============================================

local function equipRifle()
    local character = player.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    local currentTool = character:FindFirstChildOfClass("Tool")
    if currentTool and (currentTool.Name == "M1 Garand" or currentTool.Name == "Rifle") then
        return true
    end
    
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return false end
    
    local rifle = backpack:FindFirstChild("M1 Garand") or backpack:FindFirstChild("Rifle")
    if rifle then
        humanoid:EquipTool(rifle)
        return true
    end
    
    return false
end

-- ============================================
-- FLOAT / HOVER
-- ============================================

local function setupFloat(targetY)
    local character = player.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if floatAttachment then floatAttachment:Destroy() end
    if floatForce then floatForce:Destroy() end
    if floatAlign then floatAlign:Destroy() end
    
    currentFloatY = targetY
    
    floatAttachment = Instance.new("Attachment")
    floatAttachment.Name = "FloatAttachment"
    floatAttachment.Parent = root
    
    floatForce = Instance.new("VectorForce")
    floatForce.Name = "FloatForce"
    floatForce.Attachment0 = floatAttachment
    floatForce.RelativeTo = Enum.ActuatorRelativeTo.World
    floatForce.Parent = root
    floatForce.Force = Vector3.new(0, Workspace.Gravity * root.AssemblyMass, 0)
    
    floatAlign = Instance.new("AlignPosition")
    floatAlign.Name = "FloatAlign"
    floatAlign.Attachment0 = floatAttachment
    floatAlign.Mode = Enum.PositionAlignmentMode.OneAttachment
    floatAlign.MaxForce = math.huge
    floatAlign.Responsiveness = 200
    floatAlign.Parent = root
    
    local targetPos = Vector3.new(root.Position.X, currentFloatY, root.Position.Z)
    floatAlign.Position = targetPos
    floatAlign.Enabled = true
    
    isFloating = true
    
    root.CFrame = CFrame.new(targetPos)
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
end

local function maintainFloat()
    if not isFloating then return end
    
    local character = player.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or not floatAlign then return end
    
    local targetPos = Vector3.new(root.Position.X, currentFloatY or root.Position.Y, root.Position.Z)
    floatAlign.Position = targetPos
end

local function cleanupFloat()
    isFloating = false
    if floatAttachment then floatAttachment:Destroy() end
    if floatForce then floatForce:Destroy() end
    if floatAlign then floatAlign:Destroy() end
    floatAttachment = nil
    floatForce = nil
    floatAlign = nil
    currentFloatY = nil
end

