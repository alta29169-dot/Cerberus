-- LocalScript (Alt Account)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- ===== CONFIG =====
local TARGET_NAME = "Andromodath"
local LAUNCH_VELOCITY = 100000
local SEAT_NAME = "SBTurretSeat"
local RESET_INTERVAL = 10

-- ===== STATE =====
local bombData = {}
local launchConn = nil
local currentBomber = nil
local isResetting = false
local generation = 0  -- Increments on each reset to cancel stale loops

-- ==========================================
-- BOOST SIMULATION RADIUS
-- ==========================================
local function boostSimulationRadius()
    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", 10000)
    end)
end

-- ==========================================
-- GET TARGET PLAYER
-- ==========================================
local function getTargetPlayer()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Name == TARGET_NAME and pl ~= LocalPlayer then
            return pl
        end
    end
    return nil
end

-- ==========================================
-- SIT IN TARGET'S BOMBER
-- ==========================================
local function sitInTargetBomber()
    local bomber = nil
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "Large Bomber" then
            local owner = obj:FindFirstChild("Owner")
            if owner and owner:IsA("StringValue") and owner.Value == TARGET_NAME then
                bomber = obj
                break
            end
        end
    end
    
    if not bomber then
        print("[Alt] No Large Bomber owned by", TARGET_NAME)
        return false
    end
    
    local seat = bomber:FindFirstChild(SEAT_NAME)
    if not seat or not seat:IsA("BasePart") then
        print("[Alt] No", SEAT_NAME, "found")
        return false
    end
    
    local char = LocalPlayer.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    hrp.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
    currentBomber = bomber
    print("[Alt] ✅ Seated in", TARGET_NAME .. "'s Large Bomber")
    return true
end

-- ==========================================
-- APPLY LAUNCH TO BOMB
-- ==========================================
local function applyLaunchToBomb(bomb)
    if not bomb or not bomb.Parent then return end
    if bombData[bomb] then return end
    
    bombData[bomb] = { launched = true }
    
    task.spawn(function()
        for i = 1, 10 do
            if bomb and bomb.Parent then
                bomb.AssemblyLinearVelocity = Vector3.new(0, LAUNCH_VELOCITY, 0)
            end
            task.wait(0.05)
        end
    end)
end

-- ==========================================
-- MAIN LAUNCH LOOP
-- ==========================================
local function startLaunchLoop(myGen)
    if launchConn then
        launchConn:Disconnect()
        launchConn = nil
    end
    
    launchConn = RunService.Heartbeat:Connect(function(dt)
        if myGen ~= generation then return end  -- Stale loop, ignore
        
        -- Check if still seated
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid and not humanoid.SeatPart then
                sitInTargetBomber()
            end
        end
        
        -- Find and launch bombs
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "Bomb" and obj:IsA("BasePart") and not bombData[obj] then
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local dist = (obj.Position - myRoot.Position).Magnitude
                    if dist <= 300 then
                        applyLaunchToBomb(obj)
                    end
                end
            end
        end
        
        -- Clean up destroyed bombs
        for bomb, data in pairs(bombData) do
            if not bomb.Parent then
                bombData[bomb] = nil
            end
        end
    end)
end

-- ==========================================
-- RESET CHARACTER
-- ==========================================
local function resetCharacter()
    if isResetting then return end
    isResetting = true
    
    generation = generation + 1  -- Invalidate current loop
    local myGen = generation
    
    print("[Alt] 🔄 Resetting character...")
    
    -- Stop launch loop
    if launchConn then
        launchConn:Disconnect()
        launchConn = nil
    end
    
    -- Clear bomb data
    table.clear(bombData)
    
    -- Kill self to force respawn
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Health = 0
        end
    end
    
    -- Wait for respawn (CharacterAdded will handle re-seating)
    task.wait(5)
    
    isResetting = false
    print("[Alt] ✅ Reset cycle complete")
end

-- ==========================================
-- RESPAWN HANDLER
-- ==========================================
LocalPlayer.CharacterAdded:Connect(function()
    print("[Alt] Respawn detected — waiting...")
    task.wait(3)
    
    generation = generation + 1
    local myGen = generation
    
    boostSimulationRadius()
    task.wait(0.5)
    sitInTargetBomber()
    startLaunchLoop(myGen)
end)

-- ==========================================
-- INITIAL SETUP
-- ==========================================
boostSimulationRadius()

if LocalPlayer.Character then
    task.wait(1)
    sitInTargetBomber()
    startLaunchLoop(generation)
end

-- ==========================================
-- RESET LOOP
-- ==========================================
task.spawn(function()
    while true do
        task.wait(RESET_INTERVAL)
        resetCharacter()
    end
end)

print("🎯 Alt turret gunner loaded (10s reset cycle)")
